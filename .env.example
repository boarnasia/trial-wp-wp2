# イメージとポート
WP_IMAGE=wordpress:6.7-apache
WP_DEBUG_PORT=8082

# サイト URL（リバースプロキシ経由の公開 URL）
WP_HOME=https://local.wp2.yamashita109.com
WP_DEBUG=1
WP_TABLE_PREFIX=wp_

# データベース（change-me は dev-env:install がランダム値に置き換える）
MYSQL_DATABASE=wordpress
MYSQL_USER=wordpress
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

# 初期セットアップ用の管理者
WP_TITLE=wp2 (WordPress 6)
WP_ADMIN_USER=admin
WP_ADMIN_PASSWORD=change-me
WP_ADMIN_EMAIL=admin@example.com
